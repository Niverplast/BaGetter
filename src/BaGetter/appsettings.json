  //    }
  //  }
  //},

  // Uncomment this to configure authentication. This example uses Azure AD, but BaGetter also supports API keys and username/password credentials.
  //"Authentication": {
  //  "Mode": "Hybrid",
  //  "Entra": {
  //    "Instance": "https://login.microsoftonline.com/",
  //    "TenantId": "",
