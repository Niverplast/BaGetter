{
  "ApiKey": "",
  "PackageDeletionBehavior": "Unlist",
  "AllowPackageOverwrites": false,
  "MaxPackageSizeGiB": 8,

  "Database": {
    "Type": "Sqlite",
    "ConnectionString": "Data Source=bagetter.db"
  },

  "Storage": {
    "Type": "FileSystem",
    "Path": ""
  },

  "Search": {
    "Type": "Database"
  },

  // Uncomment to enable email sending. "Type" selects the backend: "Smtp", "Graph", or "Null" (disabled, the default when omitted).
  //"Email": {
  //  "Type": "Smtp",
