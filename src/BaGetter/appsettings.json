  //      "Username": "username",
  //      "Password": "password"
  //    }
  //  ],
  //  "ApiKeys": [
  //    {
  //      "Key": "key"
  //    }
  //  ]
  //},

  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Microsoft.Hosting.Lifetime": "Information",
        "BaGetter.Core.Notifications.PatExpiryNotificationService": "Information",
        "Default": "Warning"
      }
    }
  },

  "HealthCheck": {
    "Path": "/health"
  },

  "Statistics": {
    "EnableStatisticsPage": true,
    "ListConfiguredServices": true
  }



}
